# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# AI provider — use ONE of the two below.
# Option A: GitHub Personal Access Token (free, uses GitHub Models / Azure endpoint)
GITHUB_TOKEN="ghp_your_personal_access_token_here"
# Option B: OpenAI API key (paid, uses OpenAI directly)
# OPENAI_API_KEY="sk-..."


# ─── RECOMMENDED (enables RAG / semantic search) ─────────────────────────────

# Pinecone vector database — create a free serverless index at pinecone.io
# Index spec: 1536 dimensions, cosine metric, us-east-1 (AWS)
PINECONE_API_KEY="pcsk_your_pinecone_api_key_here"
PINECONE_INDEX_NAME="fypai-messages"


# ─── OPTIONAL (Redis — for background embedding queue) ───────────────────────
# The app runs without Redis; embeddings are simply skipped when unavailable.
# Install Memurai (Windows) or use Docker: docker run -p 6379:6379 redis

REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""
# REDIS_DB="0"


# ─── OPTIONAL (server / CORS) ────────────────────────────────────────────────

PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Allow multiple frontend origins (comma-separated), e.g. for LAN testing
# FRONTEND_URLS="http://localhost:5173,http://192.168.1.x:5173"


# ─── OPTIONAL (tuning / feature flags) ──────────────────────────────────────

# Allow the AI agent to create / modify chime rules at runtime (default: false)
# ENABLE_CHIME_RULE_MUTATIONS="true"

# Embedding worker batch size (default: 20)
# EMBEDDING_BATCH_SIZE="20"

# Max time (ms) before flushing a partial embedding batch (default: 60000)
# EMBEDDING_FLUSH_TIMEOUT_MS="60000"

# Number of recent AI insights injected as context fallback (default: 6)
# AI_RECENT_INSIGHTS_CONTEXT_LIMIT="6"

# Automatic backfill scheduler for deferred embeddings (default: true)
# ENABLE_EMBEDDING_BACKFILL_SCHEDULER="true"
# EMBEDDING_BACKFILL_INTERVAL_MS="300000"
# EMBEDDING_BACKFILL_BATCH_SIZE="100"


# ─── OPTIONAL (error tracking) ───────────────────────────────────────────────

# Sentry DSN — omit to disable error tracking
# SENTRY_DSN="https://..."
